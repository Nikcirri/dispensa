<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Pasti": grande 3×2 quando lo aggiungi (oggi e domani); più basso mostra solo oggi, più alto anche dopodomani.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_meals_desc"
    android:initialLayout="@layout/widget_meals"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:previewLayout="@layout/widget_meals_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
