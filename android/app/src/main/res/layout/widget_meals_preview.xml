<?xml version="1.0" encoding="utf-8"?>
<!--
  Anteprima del widget "Pasti" nell'elenco dei widget del telefono: pasti di esempio.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_meals_title"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn_accent"
            android:contentDescription="@string/widget_open_meals"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="@color/widget_on_accent"
            android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_preview_today" android:textColor="@color/widget_day" android:textSize="12sp" android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="☀️" android:textSize="15sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="🍝 Pasta al pomodoro" android:textColor="@color/widget_text" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="🌙" android:textSize="15sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="🍲 Minestrone di verdure" android:textColor="@color/widget_text" android:textSize="14sp" />
    </LinearLayout>
    </LinearLayout>

</LinearLayout>
