<?xml version="1.0" encoding="utf-8"?>
<!-- Pranzo o cena nel widget "Pasti": l'icona e i piatti (in grigio con la spunta se già cucinati, o "—"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="26dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/meal_slot"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="☀️"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/meal_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Pasta al pesto"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/meal_title_muted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="—"
        android:textColor="@color/widget_muted"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
