<?xml version="1.0" encoding="utf-8"?>
<!--
  Un prodotto del widget "Spesa": cerchio da spuntare (vuoto o pieno con la spunta), icona, nome e specifiche.
  Del nome se ne vede uno: normale da comprare, grigio e barrato se è già nel carrello. Tutta la riga si tocca.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shop_row"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <TextView
        android:id="@+id/shop_check_off"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/widget_check_off"
        android:text="" />

    <TextView
        android:id="@+id/shop_check_on"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/widget_check_on"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="✓"
        android:textColor="@color/widget_on_accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/shop_emoji"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="🍝"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/shop_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Pasta"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/shop_name_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Pane"
            android:textColor="@color/widget_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shop_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="2 × penne rigate · spaghetti"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
