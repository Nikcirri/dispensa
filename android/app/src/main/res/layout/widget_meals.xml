<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Pasti": pranzo e cena di oggi (e dei giorni dopo, se è alto).
  Le righe le aggiunge MealsWidget (widget_meal_day e widget_meal_row). Solo viste ammesse nei widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_meals_title"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meal_open"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn_accent"
            android:contentDescription="@string/widget_open_meals"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="@color/widget_on_accent"
            android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/meal_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/meal_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_meals_empty"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
